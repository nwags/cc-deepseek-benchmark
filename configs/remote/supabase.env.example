# Supabase/Postgres metadata database settings.
# Copy values into an ignored local secret file or GitHub Actions secrets.
# Do not commit real credentials.

# Preferred direct Postgres connection string for ingestion jobs.
# Example shape only:
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_DB_URL="postgresql://postgres.example:<password>@example.pooler.supabase.com:6543/postgres?sslmode=require"

# Optional Supabase project metadata for dashboards/API work later.
SUPABASE_URL="https://example.supabase.co"
SUPABASE_ANON_KEY="<supabase-anon-key>"
SUPABASE_SERVICE_ROLE_KEY="<supabase-service-role-key>"
