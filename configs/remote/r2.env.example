# Cloudflare R2 artifact storage settings.
# Copy values into an ignored local secret file or GitHub Actions secrets.
# Do not commit real credentials.

R2_ACCOUNT_ID="<cloudflare-account-id>"
R2_ACCESS_KEY_ID="<r2-access-key-id>"
R2_SECRET_ACCESS_KEY="<r2-secret-access-key>"
R2_BUCKET="benchmarking"
R2_ENDPOINT_URL="https://<cloudflare-account-id>.r2.cloudflarestorage.com"

# Optional prefix so pilot uploads can be kept separate from later smoke/full-sweep uploads.
R2_PREFIX="terminal-bench/model-backends"

# Cloudflare R2 S3-compatible API region. Avoid AWS defaults such as us-east-2.
R2_REGION="auto"
