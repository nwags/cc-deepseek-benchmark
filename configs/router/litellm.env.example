# LiteLLM proxy-local secret.
# Do not commit a real .secrets/litellm.env file.

LITELLM_MASTER_KEY=sk-local-litellm-benchmark-key

# Provider API keys should remain in provider-specific files:
#
#   .secrets/anthropic.env
#   .secrets/deepseek.env
#   .secrets/openai.env
#   .secrets/gemini.env
#   .secrets/xai.env
#   .secrets/kimi.env
#   .secrets/dashscope.env
#   .secrets/zai.env
#
# scripts/start_litellm_proxy.sh sources these files into the LiteLLM
# process environment so LiteLLM can resolve config entries such as:
#
#   api_key: os.environ/DEEPSEEK_API_KEY
#
# To override the provider env-file list:
#
#   LITELLM_PROVIDER_ENV_FILES=".secrets/deepseek.env .secrets/anthropic.env" make litellm-up
