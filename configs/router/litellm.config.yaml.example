# Example LiteLLM proxy config for Phase 3 router-mediated Claude Code runs.
#
# Copy this to:
#
#   configs/router/litellm.config.yaml
#
# Then adjust model slugs if the provider/router requires different names.
# This file intentionally references environment variables only. Do not put
# raw API keys in this file.

model_list:
  # Anthropic control routes.
  - model_name: router-anthropic-haiku
    litellm_params:
      model: anthropic/claude-haiku-4-5-20251001
      api_key: os.environ/ANTHROPIC_API_KEY

  - model_name: router-anthropic-sonnet
    litellm_params:
      model: anthropic/claude-sonnet-4-6
      api_key: os.environ/ANTHROPIC_API_KEY

  - model_name: router-anthropic-opus
    litellm_params:
      model: anthropic/claude-opus-4-7
      api_key: os.environ/ANTHROPIC_API_KEY

  - model_name: router-anthropic-fable-5
    litellm_params:
      model: anthropic/claude-fable-5
      api_key: os.environ/ANTHROPIC_API_KEY

  # DeepSeek router-mediated controls.
  # Verify these exact slugs with the selected DeepSeek/LiteLLM route before paid canaries.
  - model_name: router-deepseek-pro
    litellm_params:
      model: deepseek/deepseek-v4-pro
      api_key: os.environ/DEEPSEEK_API_KEY

  - model_name: router-deepseek-flash
    litellm_params:
      model: deepseek/deepseek-v4-flash
      api_key: os.environ/DEEPSEEK_API_KEY

  # OpenAI routes.
  # Verify availability and exact slugs before paid canaries.
  - model_name: router-gpt-5.5
    litellm_params:
      model: openai/gpt-5.5
      api_key: os.environ/OPENAI_API_KEY

  - model_name: router-gpt-5.4
    litellm_params:
      model: openai/gpt-5.4
      api_key: os.environ/OPENAI_API_KEY

  - model_name: router-gpt-5.3
    litellm_params:
      model: openai/gpt-5.3
      api_key: os.environ/OPENAI_API_KEY

  # Google AI Studio Gemini routes.
  # Verify availability and exact slugs before paid canaries.
  - model_name: router-gemini-3.1-pro
    litellm_params:
      model: gemini/gemini-3.1-pro-preview
      api_key: os.environ/GEMINI_API_KEY

  - model_name: router-gemini-flash
    litellm_params:
      model: gemini/gemini-3.5-flash
      api_key: os.environ/GEMINI_API_KEY

  # xAI / Grok build route.
  - model_name: router-grok-build-0.1
    litellm_params:
      model: xai/grok-build-0.1
      api_key: os.environ/XAI_API_KEY

  # Moonshot / Kimi route.
  - model_name: router-kimi-k2.6
    litellm_params:
      model: moonshot/kimi-k2.6
      api_key: os.environ/MOONSHOT_API_KEY

  # Z.AI / GLM route.
  - model_name: router-glm-5.1
    litellm_params:
      model: zai/glm-5.1
      api_key: os.environ/ZAI_API_KEY


  # xAI route.
  - model_name: router-grok-3
    litellm_params:
      model: xai/grok-3
      api_key: os.environ/XAI_API_KEY

  # Moonshot/Kimi route.
  # LiteLLM uses the moonshot/ provider prefix for Moonshot AI / Kimi models.
  - model_name: router-kimi-k2.5
    litellm_params:
      model: moonshot/kimi-k2.5
      api_key: os.environ/MOONSHOT_API_KEY

  # Alibaba DashScope / Qwen route.
  # LiteLLM uses DASHSCOPE_API_KEY for DashScope Qwen models.
  - model_name: router-qwen-3.7-plus
    litellm_params:
      model: dashscope/qwen3.7-plus
      api_key: os.environ/DASHSCOPE_API_KEY
      api_base: https://dashscope-intl.aliyuncs.com/compatible-mode/v1


  # Z.AI / GLM route.
  # LiteLLM uses the zai/ provider prefix and ZAI_API_KEY.
  - model_name: router-glm-5
    litellm_params:
      model: zai/glm-5
      api_key: os.environ/ZAI_API_KEY

general_settings:
  master_key: os.environ/LITELLM_MASTER_KEY

litellm_settings:
  drop_params: true
  set_verbose: false
