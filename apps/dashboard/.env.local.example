# Server-side only. Do not prefix with NEXT_PUBLIC.
SUPABASE_DB_URL=postgresql://postgres.<project-id>:<password>@aws-0-us-east-2.pooler.supabase.com:6543/postgres

# Optional server-side R2 preview support. Do not prefix with NEXT_PUBLIC.
R2_ACCESS_KEY_ID="<r2-access-key-id>"
R2_SECRET_ACCESS_KEY="<r2-secret-access-key>"
R2_BUCKET="benchmarking"
R2_ENDPOINT_URL="https://<cloudflare-account-id>.r2.cloudflarestorage.com"
R2_REGION="auto"

# Optional local fallback for explicitly rehydrated artifacts.
# R2 remains the primary content source. Leave disabled unless the cache has been populated intentionally.
DASHBOARD_ENABLE_LOCAL_ARTIFACT_PREVIEW=0
DASHBOARD_ARTIFACT_CACHE_DIR=".dashboard-artifact-cache"

# Optional local task text cache. The dashboard does not read the full Terminal-Bench checkout by default.
DASHBOARD_ENABLE_LOCAL_TASK_TEXT_PREVIEW=0
DASHBOARD_TASK_TEXT_CACHE_DIR=".dashboard-artifact-cache/task-text"

# Development only. Shared Supabase live tables are the production source.
# Set to true only to inspect workstation-local .run/live NDJSON when shared
# live state is unavailable.
DASHBOARD_LIVE_LOCAL_FALLBACK=false
